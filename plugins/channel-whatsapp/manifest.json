{
  "package": "@gen/channel-whatsapp",
  "name": "Kênh WhatsApp",
  "version": "2.2.0",
  "layer": "channel",
  "entry": null,
  "description": "Đăng nhập WhatsApp bằng QR tài khoản thật; nhận tin các nhóm Owner đã bật; gửi tin chỉ khi có permit.",
  "permissions": [
    "channel.receive",
    "channel.send"
  ],
  "events": {
    "subscribe": [
      "gh.bridge.control",
      "gh.bridge.outbound"
    ],
    "publish": [
      "gh.bridge.inbound",
      "gh.bridge.status",
      "gh.bridge.directory"
    ]
  },
  "settings_schema": {},
  "sandbox": {
    "mode": "inprocess",
    "memory_mb": 256,
    "timeout_s": 30,
    "net": "internal"
  },
  "dependencies": {
    "@gen/chassis-bus": "^2.2.0",
    "@gen/chassis-policy": "^2.2.0"
  },
  "load_order": 6,
  "removable": false,
  "can_disable": true
}
