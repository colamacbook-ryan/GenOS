{
  "_doc": "Thuật ngữ chuẩn + chữ cấm + baseline hiện trạng (lưới L5/L4). Xem docstring check_terms.py. Baseline chỉ được GIẢM: sửa xong chữ nào thì chạy `python3 .github/scripts/check_terms.py --lower` (hoặc CRAWL_LOWER_BASELINE=1 cho route-crawl) và commit.",
  "canonical": [
    "Sếp",
    "Gen nhớ",
    "Ghi nhớ",
    "Ghi vào Kho dữ liệu",
    "Kho dữ liệu",
    "Kho của Sếp",
    "Gen-hub",
    "mã PIN",
    "Việc Sếp cần làm",
    "khoá",
    "API & Model",
    "Lắng nghe im lặng"
  ],
  "forbidden": [
    {
      "id": "khoa-dau-hoi",
      "pattern": "\\b[Kk]hóa\\b(?! học)",
      "use": "viết «khoá» (cách viết của repo), không «khóa»",
      "static": true,
      "crawl": true
    },
    {
      "id": "kho-tri-thuc",
      "pattern": "Kho tri thức",
      "use": "viết «Kho dữ liệu» (hoặc tên Kho Sếp tự đặt qua kho_label)",
      "static": true,
      "crawl": true
    },
    {
      "id": "kho-ten-rieng",
      "pattern": "Kho R[y]an",
      "use": "viết «Kho dữ liệu» — QD-22: không tên riêng của Sếp trong chuỗi chạy thật",
      "static": true,
      "crawl": true,
      "allow_files": [
        "db/sql/"
      ]
    },
    {
      "id": "nhap-pin",
      "pattern": "\\b[Nn]hập PIN\\b",
      "use": "viết «nhập mã PIN»",
      "static": true,
      "crawl": true
    },
    {
      "id": "agent-model-ten-man",
      "pattern": "Agent & Model",
      "use": "tên màn là «API & Model»; «Agent & Model» chỉ là tên nhóm menu, đừng chỉ đường bằng nó",
      "static": true,
      "crawl": false
    },
    {
      "id": "vai-tieng-anh",
      "pattern": "(?<!Account )\\b(?:Manager|Operator|Auditor)\\b",
      "use": "dùng tên vai tiếng Việt (Quản lý, Vận hành, Kiểm soát) qua một bảng tên chung",
      "static": true,
      "crawl": true,
      "multiword_only": true
    },
    {
      "id": "nghe-im-lang",
      "pattern": "(?<!Lắng )[Nn]ghe im lặng",
      "use": "viết «Lắng nghe im lặng»",
      "static": true,
      "crawl": true
    },
    {
      "id": "value-error",
      "pattern": "Value error",
      "use": "bỏ tiền tố pydantic, chỉ giữ câu tiếng Việt",
      "static": false,
      "crawl": true
    },
    {
      "id": "trang-thai-tho",
      "pattern": "\\b(?:failed|approved|rejected)\\b",
      "use": "dịch trạng thái sang tiếng Việt qua bảng nhãn",
      "static": false,
      "crawl": true
    },
    {
      "id": "tu-ky-thuat",
      "pattern": "\\b(?:worker|Bridge|TUI|Template|Prefill|chat_id|kho_create|kho_update|kho_read|persona)\\b",
      "use": "nói bằng lời Sếp hiểu (tiến trình nền, cầu nối, trình cài, mẫu…); mã kỹ thuật chỉ để trong «Chi tiết kỹ thuật»",
      "static": false,
      "crawl": true
    }
  ],
  "baseline": {
    "agent-model-ten-man": {
      "apps/api/gh/shell/navigation.py": 1,
      "packages/contracts/src/screens.ts": 5
    }
  },
  "crawl_baseline": {
    "1440|/clean|term:tu-ky-thuat": 1,
    "1440|/connections|term:tu-ky-thuat": 3,
    "1440|/guide/14→/connections|term:tu-ky-thuat": 3,
    "1440|/guide/viec-sep|term:tu-ky-thuat": 2,
    "1440|/help|term:tu-ky-thuat": 3,
    "1440|/plugins|term:vai-tieng-anh": 2,
    "1440|/raw|term:tu-ky-thuat": 1,
    "1440|/rules|term:tu-ky-thuat": 1,
    "1440|/supply|rac": 1,
    "390|/clean|term:tu-ky-thuat": 1,
    "390|/connections|term:tu-ky-thuat": 3,
    "390|/guide/14→/connections|term:tu-ky-thuat": 3,
    "390|/guide/viec-sep|term:tu-ky-thuat": 2,
    "390|/help|term:tu-ky-thuat": 3,
    "390|/plugins|term:vai-tieng-anh": 2,
    "390|/raw|term:tu-ky-thuat": 1,
    "390|/rules|term:tu-ky-thuat": 1,
    "390|/supply|rac": 1
  }
}
