# Sao chép thành .env cho môi trường phát triển. Trình cài (genh) sinh các giá trị này khi cài thật.
GH_ENV=development
GH_PUBLIC_URL=https://localhost:8443
POSTGRES_USER=gh
POSTGRES_PASSWORD=change-me
POSTGRES_DB=gen_harness
# Mật khẩu role gh_app hạn quyền (api/worker dùng để RLS có hiệu lực — KHÁC
# POSTGRES_PASSWORD ở trên, mật khẩu superuser chỉ migrate/backup dùng).
GH_APP_DB_PASSWORD=change-me-too
# Khoá master KHÔNG nằm ở đây: `make secrets` sinh ./secrets/gh_master_key (Docker secret, không commit).
# Mã thiết lập một lần cho /setup (để trống thì api tự sinh và in ra log lúc khởi động)
GH_SETUP_TOKEN=
# Tinh chỉnh Postgres theo RAM máy — để trống dùng mặc định an toàn của
# deploy/compose.yaml (256MB/768MB/4MB/64MB); `genh install` tự tính và ghi
# các biến này khi cài thật (xem apps/genh/internal/pgtune).
GH_PG_SHARED_BUFFERS=
GH_PG_EFFECTIVE_CACHE_SIZE=
GH_PG_WORK_MEM=
GH_PG_MAINTENANCE_WORK_MEM=
# Truy cập từ xa (genh quản lý — đổi bằng `genh remote`; để comment thì mặc định của compose áp dụng).
# GH_BIND_ADDR=127.0.0.1
# GH_SITE_ADDRESS=
# GH_PUBLIC_URL=https://localhost:8443
